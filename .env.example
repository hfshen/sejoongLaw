# =========================================================
# Sejoong StayCare production environment template
# Never commit real secrets. Configure them in Vercel Settings.
# =========================================================

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STAYCARE_TENANT_SLUG=sejoong-staycare
STAYCARE_DEFAULT_LOCALE=ko
STAYCARE_SUPPORT_EMAIL=staycare@sejoonglaw.kr
STAYCARE_SUPPORT_PHONE=

# Supabase - required
NEXT_PUBLIC_SUPABASE_URL=
# New Supabase projects use a publishable key. The existing ANON key is accepted as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STAYCARE_STORAGE_BUCKET=staycare-private

# OpenAI - required for AI translation / life guidance
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5

# Distributed rate limiting - required in production
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email - required for production notifications and login fallback
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sejoong StayCare <staycare@sejoonglaw.kr>

# SMS - optional until SMS notifications are enabled
COOLSMS_API_KEY=
COOLSMS_API_SECRET=
COOLSMS_SENDER_PHONE=

# Cloudflare Turnstile - recommended for login/onboarding/public forms
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Monitoring - recommended
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.05

# Maps / nearby hospitals, banks and public offices - optional
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY=

# Push notifications - optional until web/mobile push is enabled
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Payment - optional. Enable only after Sejoong decides what is charged in-app.
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
TOSS_PAYMENTS_WEBHOOK_SECRET=

# Internal security secrets - generate separately per environment
# openssl rand -base64 32
STAYCARE_FIELD_ENCRYPTION_KEY=
# openssl rand -hex 32
STAYCARE_WEBHOOK_SECRET=
STAYCARE_CRON_SECRET=

# Provider integration modes
# manual: operator fulfills through the provider portal
# sandbox: provider test API
# api: contracted production API
TELECOM_PROVIDER_MODE=manual
TELECOM_PROVIDER_BASE_URL=
TELECOM_PROVIDER_API_KEY=
TELECOM_PROVIDER_WEBHOOK_SECRET=

BANK_PROVIDER_MODE=manual
BANK_PROVIDER_BASE_URL=
BANK_PROVIDER_API_KEY=
BANK_PROVIDER_WEBHOOK_SECRET=

REMITTANCE_PROVIDER_MODE=manual
REMITTANCE_PROVIDER_BASE_URL=
REMITTANCE_PROVIDER_API_KEY=
REMITTANCE_PROVIDER_WEBHOOK_SECRET=

DELIVERY_PROVIDER_MODE=manual
DELIVERY_PROVIDER_BASE_URL=
DELIVERY_PROVIDER_API_KEY=
DELIVERY_PROVIDER_WEBHOOK_SECRET=

# Search engine verification - existing website
GOOGLE_VERIFICATION=
NAVER_VERIFICATION=
